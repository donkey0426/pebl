    "scale_info": {
      "name": "Explicit Memory in Iowa Gambling Task",
      "code": "emigt",
      "abbreviation": "EM-IGT",
      "description": "8-item questionnaire assessing explicit memory of card deck outcomes following the (computerized) Iowa Gambling Task. Each item asks the participant to identify which deck (A, B, C, or D) was associated with a specific outcome pattern.",
      "license": "CC BY 4.0",
      "version": "1.0"
    },
    "implementation": {
